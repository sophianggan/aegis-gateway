AEGIS_ENVIRONMENT=development
AEGIS_LOG_LEVEL=INFO
AEGIS_DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis
AEGIS_PERSISTENCE=postgres
AEGIS_JWT_SECRET=replace-with-at-least-32-characters
AEGIS_AUDIT_HMAC_KEY=replace-with-at-least-32-characters
AEGIS_MODEL_PROVIDER=deterministic
AEGIS_MODEL_BASE_URL=http://localhost:11434/v1
AEGIS_MODEL_API_KEY=
AEGIS_MODEL_NAME=local-model
AEGIS_REQUEST_TIMEOUT_SECONDS=30
AEGIS_MAX_MODEL_RESPONSE_CHARACTERS=32000
AEGIS_MAX_RECORD_BYTES=1000000
AEGIS_RATE_LIMIT_REQUESTS_PER_MINUTE=60
AEGIS_RATE_LIMIT_BURST=10
AEGIS_RATE_LIMIT_MAX_IDENTITIES=10000
AEGIS_METRICS_ENABLED=true
